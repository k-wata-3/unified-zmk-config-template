//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

//スクリーンショット(Win + Shift + S)
#define SC_GS_s LG(LS(S))
//タスクマネージャー(Ctrl + Shift + ESC)
#define SC_CS_esc LS(LC(ESC))
//ウインドウ起動(Ctrl + Shift + Delete)
#define SC_CS_del LA(LC(DEL))

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

//独自のビヘイビア定義
/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };

        //1回タップの長押しで &mo 1、2回タップの長押しで &mo 2
        mo12: mo12 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 1>, <&mo 2>;
        };

        // 1回タップ:
        //   通常      -> ;
        //   Shift中   -> +
        semi_plus: semi_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp PLUS>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        // 2回タップ:
        //   通常      -> :
        //   Shift中   -> *
        colon_star: colon_star {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp ASTERISK>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        // タップ回数で切り替える
        semi_colon_td: semi_colon_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&semi_plus>, <&colon_star>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";

        //-----------------------------------------------------
        //0レイヤーのコンボ
        //-----------------------------------------------------
        //英数入力 14はS、15はDのキーに相当
	    combo_LANG2 {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LANG2>;
            layers = <0>; //0番レイヤーでのみ有効にする
        };
        //かな入力 15はD、16はFのキー のキーに相当
	    combo_LANG1 {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LANG1>;
            layers = <0>; //0番レイヤーでのみ有効にする
        };
        //3番レイヤー 38はMO1のキー 39はSpaceのキーに相当
	    combo_MO3 {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&mo 3>;
            layers = <0>; //0番レイヤーでのみ有効にする
        };

		//左クリックのコンボ 19はJのキー 20はKのキーに相当
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
            layers = <0>; //0番レイヤーでのみ有効にする
        };
		//右クリックのコンボ 20はKのキー 21はLのキーに相当
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
            layers = <0>; //0番レイヤーでのみ有効にする
        };
		//ホイールクリックのコンボ 19はJのキー 21はLのキーに相当
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
            layers = <0>; //0番レイヤーでのみ有効にする
        };

        //-----------------------------------------------------
        //1レイヤーのコンボ
        //-----------------------------------------------------

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp ESC   &kp Q   &kp W  &kp E  &kp R  &kp T          &kp Y           &kp U  &kp I      &kp O    &kp P     &kp BSPC
            &kp TAB   &kp A   &kp S  &kp D  &kp F  &kp G          &kp H           &kp J  &kp K      &kp L    &kp SLASH &kp ENTER
            &kp LSHFT &kp Z   &kp X  &kp C  &kp V  &kp B          &kp N           &kp M  &kp COMMA  &kp DOT  &kp SQT   &kp LSHFT
            &kp LCTRL &kp LALT              &mo12  &kp SPACE      &semi_colon_td  &kp LA(GRAVE)              &mo 3     &kp LGUI
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

    layer_1 {
        bindings = <
            &kp ESC   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0 &kp DEL
            &kp TAB   &trans  &trans  &trans  &trans  &trans      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans &trans
            &kp LSHFT &trans  &trans  &trans  &trans  &trans      &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans &trans
            &kp LCTRL &trans                  &trans  &trans      &trans    &trans                        &trans &trans
        >;
    };

    layer_2 {
        bindings = <
            &kp ESC   &kp F1  &kp F2  &kp F3      &kp F4         &kp F5           &trans  &trans    &kp MINUS &kp EQUAL &trans     &trans
            &kp TAB   &kp F6  &kp F7  &kp F8      &kp F9         &kp F10          &trans  &kp LBKT  &kp RBKT  &kp NUBS  &trans     &trans
            &kp LSHFT &kp F11 &kp F12 &trans      &trans         &trans           &trans  &kp SEMI  &kp SQT   &trans    &kp QMARK  &kp BSLH
            &kp LCTRL &trans          &SC_CS_del  &kp SC_CS_esc  &kp SC_GS_s      &trans  &trans                        &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &trans         &trans
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans      &trans  &out OUT_BLE                              &trans         &trans
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
